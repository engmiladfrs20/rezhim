{
  "name": "nutriai-persia-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20 <23",
    "pnpm": "9.15.9"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml,jsonc}\"",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml,jsonc}\"",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "data:validate": "node scripts/data-pipeline.mjs",
    "data:dry-run": "node scripts/data-pipeline.mjs --dry-run",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^22.13.4",
    "eslint": "^9.20.1",
    "eslint-config-prettier": "^10.0.1",
    "globals": "^15.15.0",
    "prettier": "^3.5.1",
    "turbo": "^2.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.1"
  },
  "pnpm": {
    "overrides": {
      "tar": ">=6.2.2",
      "image-size": ">=2.0.2",
      "postcss@<8.5.10": ">=8.5.10",
      "@xmldom/xmldom@<0.8.12": ">=0.8.12",
      "@xmldom/xmldom@<0.8.13": ">=0.8.13",
      "uuid@<11.1.1": ">=11.1.1",
      "postcss@<=8.5.11": ">=8.5.12",
      "postcss@<=8.5.22": ">=8.5.23",
      "postcss@<=8.5.17": ">=8.5.18"
    }
  }
}
