{
  "name": "@nutriai/storage",
  "version": "1.0.0",
  "private": true,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "node -e \"const fs=require('fs');['dist','tsconfig.tsbuildinfo','coverage','.expo','.wrangler'].forEach(p=>fs.rmSync(p,{recursive:true,force:true}))\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.750.0",
    "@aws-sdk/s3-request-presigner": "^3.750.0",
    "@nutriai/schemas": "workspace:*",
    "@nutriai/types": "workspace:*"
  },
  "devDependencies": {
    "@nutriai/config": "workspace:*",
    "@vitest/coverage-v8": "^3.0.7",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
