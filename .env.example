# ==============================================================================
# NutriAI Persia - Environment Configuration (Phase 1 Template)
# Never commit real credentials or production secrets to source control.
# ==============================================================================

# Application Environment
APP_ENV=development
SERVICE_NAME=nutriai-api
APP_VERSION=1.0.0
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Cloudflare Workers & Public Web Client
VITE_APP_ENV=development
VITE_API_BASE_URL=http://localhost:8787
VITE_DEFAULT_LOCALE=fa

# Backblaze B2 S3-Compatible Storage Secrets (Worker bindings / Cloudflare secrets)
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004
B2_BUCKET_NAME=nutriai-media-dev
B2_KEY_ID=your-b2-key-id
B2_APPLICATION_KEY=your-b2-application-key
