{
  "name": "@nutriai/worker-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "wrangler deploy --dry-run --outdir=dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "node -e \"const fs=require('fs'); ['.turbo','dist','coverage','.expo','.wrangler'].forEach(p=>fs.rmSync(p,{recursive:true,force:true}))\"",
    "db:migrations:list:local": "wrangler d1 migrations list DB --local",
    "db:migrations:apply:local": "wrangler d1 migrations apply DB --local"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.0",
    "@nutriai/localization": "workspace:*",
    "@nutriai/schemas": "workspace:*",
    "@nutriai/types": "workspace:*",
    "hono": "^4.7.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.1",
    "@cloudflare/workers-types": "^4.20250224.0",
    "@nutriai/config": "workspace:*",
    "@vitest/coverage-istanbul": "^4.1.0",
    "@vitest/runner": "^4.1.0",
    "@vitest/snapshot": "^4.1.0",
    "typescript": "^5.7.3",
    "vitest": "^4.1.0",
    "wrangler": "^3.111.0"
  }
}
