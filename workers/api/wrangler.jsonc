{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nutriai-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-02-24",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "APP_ENV": "development",
    "SERVICE_NAME": "nutriai-api",
    "APP_VERSION": "1.0.0",
    "ALLOWED_ORIGINS": "http://localhost:3000,http://localhost:3001",
    "GEMINI_MODEL": "gemini-3.6-flash",
    "CLOUDFLARE_AI_MODEL": "@cf/google/gemma-4-26b-a4b-it",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nutriai-db-dev",
      "database_id": "14979792-0b61-4fc6-a5d0-3bb9e2d83bae",
      "migrations_dir": "migrations",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "KV_CACHE",
      "id": "488fcf27edad4caa8cf00d7c108cde0b",
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "AI_JOBS_QUEUE",
        "queue": "nutriai-ai-jobs-dev",
      },
    ],
  },
  "ai": {
    "binding": "AI",
  },
  "env": {
    "staging": {
      "name": "nutriai-api-staging",
      "vars": {
        "APP_ENV": "staging",
        "SERVICE_NAME": "nutriai-api-staging",
        "APP_VERSION": "1.0.0",
        "ALLOWED_ORIGINS": "https://staging.nutriai.persia,https://staging-admin.nutriai.persia,https://nutriai-web.pages.dev,https://nutriai-admin.pages.dev",
        "GEMINI_MODEL": "gemini-3.6-flash",
        "CLOUDFLARE_AI_MODEL": "@cf/google/gemma-4-26b-a4b-it",
        "B2_ENDPOINT": "https://s3.us-east-005.backblazeb2.com",
        "B2_REGION": "us-east-005",
        "B2_BUCKET_NAME": "rezhim",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "nutriai-db-staging",
          "database_id": "7a3160bc-a7fd-42a7-a6a9-699638e81bcc",
          "migrations_dir": "migrations",
        },
      ],
      "kv_namespaces": [
        {
          "binding": "KV_CACHE",
          "id": "74d8361b88fe4d078f852951b444e318",
        },
      ],
      "queues": {
        "producers": [
          {
            "binding": "AI_JOBS_QUEUE",
            "queue": "nutriai-ai-jobs-staging",
          },
        ],
      },
      "ai": {
        "binding": "AI",
      },
    },
    "production": {
      "name": "nutriai-api-production",
      "vars": {
        "APP_ENV": "production",
        "SERVICE_NAME": "nutriai-api-production",
        "APP_VERSION": "1.0.0",
        "ALLOWED_ORIGINS": "https://nutriai.persia,https://app.nutriai.persia,https://admin.nutriai.persia,https://nutriai-web.pages.dev,https://nutriai-admin.pages.dev",
        "GEMINI_MODEL": "gemini-3.6-flash",
        "CLOUDFLARE_AI_MODEL": "@cf/google/gemma-4-26b-a4b-it",
        "B2_ENDPOINT": "https://s3.us-east-005.backblazeb2.com",
        "B2_REGION": "us-east-005",
        "B2_BUCKET_NAME": "rezhim",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "nutriai-db-prod",
          "database_id": "05c64b3e-bf96-4fff-97fa-7d1008c1006c",
          "migrations_dir": "migrations",
        },
      ],
      "kv_namespaces": [
        {
          "binding": "KV_CACHE",
          "id": "d2bd11cc2c8c4845bfb9f75f0ccf6faa",
        },
      ],
      "queues": {
        "producers": [
          {
            "binding": "AI_JOBS_QUEUE",
            "queue": "nutriai-ai-jobs-prod",
          },
        ],
      },
      "ai": {
        "binding": "AI",
      },
    },
  },
}
