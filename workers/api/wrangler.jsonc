{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nutriai-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-02-24",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "APP_ENV": "development",
    "SERVICE_NAME": "nutriai-api",
    "APP_VERSION": "1.0.0",
    "ALLOWED_ORIGINS": "http://localhost:3000,http://localhost:3001",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nutriai-db-dev",
      "database_id": "00000000-0000-0000-0000-000000000000",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "KV_CACHE",
      "id": "00000000000000000000000000000000",
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "AI_JOBS_QUEUE",
        "queue": "nutriai-ai-jobs-dev",
      },
    ],
  },
  "env": {
    "staging": {
      "name": "nutriai-api-staging",
      "vars": {
        "APP_ENV": "staging",
        "SERVICE_NAME": "nutriai-api-staging",
        "APP_VERSION": "1.0.0",
        "ALLOWED_ORIGINS": "https://staging.nutriai.persia,https://staging-admin.nutriai.persia",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "nutriai-db-staging",
          "database_id": "11111111-1111-1111-1111-111111111111",
        },
      ],
      "kv_namespaces": [
        {
          "binding": "KV_CACHE",
          "id": "11111111111111111111111111111111",
        },
      ],
      "queues": {
        "producers": [
          {
            "binding": "AI_JOBS_QUEUE",
            "queue": "nutriai-ai-jobs-staging",
          },
        ],
      },
    },
    "production": {
      "name": "nutriai-api-production",
      "vars": {
        "APP_ENV": "production",
        "SERVICE_NAME": "nutriai-api-production",
        "APP_VERSION": "1.0.0",
        "ALLOWED_ORIGINS": "https://nutriai.persia,https://app.nutriai.persia,https://admin.nutriai.persia",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "nutriai-db-prod",
          "database_id": "22222222-2222-2222-2222-222222222222",
        },
      ],
      "kv_namespaces": [
        {
          "binding": "KV_CACHE",
          "id": "22222222222222222222222222222222",
        },
      ],
      "queues": {
        "producers": [
          {
            "binding": "AI_JOBS_QUEUE",
            "queue": "nutriai-ai-jobs-prod",
          },
        ],
      },
    },
  },
}
