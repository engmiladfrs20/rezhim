{
  "name": "@nutriai/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "src/index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "build": "expo export -p android",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "node -e \"const fs=require('fs');['dist','tsconfig.tsbuildinfo','coverage','.expo','.wrangler'].forEach(p=>fs.rmSync(p,{recursive:true,force:true}))\""
  },
  "dependencies": {
    "@nutriai/localization": "workspace:*",
    "@nutriai/types": "workspace:*",
    "expo": "~52.0.0",
    "react": "18.3.1",
    "react-native": "0.76.6"
  },
  "devDependencies": {
    "@nutriai/config": "workspace:*",
    "@types/react": "~18.3.12",
    "@vitest/coverage-v8": "^4.1.0",
    "typescript": "^5.7.3",
    "vitest": "^4.1.0"
  }
}
