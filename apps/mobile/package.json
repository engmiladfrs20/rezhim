{
  "name": "@nutriai/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "src/index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "build": "expo export -p android",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "node -e \"const fs=require('fs');['dist','tsconfig.tsbuildinfo','coverage','.expo','.wrangler'].forEach(p=>fs.rmSync(p,{recursive:true,force:true}))\""
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@nutriai/localization": "workspace:*",
    "@nutriai/schemas": "workspace:^",
    "@nutriai/types": "workspace:*",
    "@tanstack/react-query": "^5.102.8",
    "expo": "~52.0.0",
    "expo-secure-store": "~14.0.1",
    "react": "18.3.1",
    "react-hook-form": "^7.86.0",
    "react-native": "0.76.9",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@nutriai/config": "workspace:*",
    "@testing-library/react-native": "^14.0.1",
    "@types/react": "~18.3.12",
    "@vitest/coverage-v8": "^4.1.0",
    "typescript": "^5.7.3",
    "vitest": "^4.1.0"
  }
}
